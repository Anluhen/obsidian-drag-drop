{
	"name": "obsidian-drag-drop",
	"version": "1.0.0",
	"description": "Obsidian plugin to drag and drop lines, list items, headings, callouts and code blocks in the editor.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	],
	"author": "Anluhen",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.1",
		"@eslint/js": "^9.39.0",
		"@eslint/json": "0.14.0",
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "1.8.7",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0"
	}
}
